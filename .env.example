# Server Configuration
PORT=5000
PUBLIC_URL=https://your-public-domain-or-ngrok.ngrok-free.app

# Firebase Configuration (RTDB)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id

# Telephony Configuration (PIOPIY / DotVoice)
TELEPHONY_PROVIDER=piopiy
PIOPIY_APP_ID=your_piopiy_app_id
PIOPIY_APP_SECRET=your_piopiy_app_secret
PIOPIY_CALLER_ID=+9180XXXXXXXX

# DotVoice Fallback Configuration
DOTVOICE_API_KEY=your_dotvoice_api_key
DOTVOICE_API_SECRET=your_dotvoice_api_secret
DOTVOICE_SIP_SERVER=sip.dotvoice.com

# AI Pipeline
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Payment Gateway (Razorpay / Stripe / Simulator)
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Messaging (WhatsApp / SMS)
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_access_token

# EOD Report Cron (Default: 9:00 PM daily)
EOD_REPORT_CRON="0 21 * * *"
REPORT_EMAIL_TO=manager@hotel.com
